<%- include("partials/header") %>


<section class="hero">

    <div>

        <span class="section-label">
            COMMUNITY SERVICE
        </span>

        <h2>
            Welcome to Service Projects
        </h2>

        <p>
            Discover organizations and service
            opportunities where you can make a
            difference in your community.
        </p>

        <a
            class="button"
            href="/projects"
        >
            View Service Projects
        </a>

    </div>

</section>


<section class="content-section">

    <div class="page-header">

        <span class="section-label">
            OUR COMMUNITY
        </span>

        <h2>
            Organizations
        </h2>

    </div>


    <div class="card-grid">

        <% organizations.forEach(
            organization => {
        %>

            <article class="card">

                <h3>
                    <%= organization.organization_name %>
                </h3>

                <p>
                    <%= organization.description %>
                </p>

                <a
                    href="/organizations"
                    class="card-link"
                >
                    View Organizations →
                </a>

            </article>

        <% }); %>

    </div>

</section>


<section class="content-section">

    <div class="page-header">

        <span class="section-label">
            VOLUNTEER
        </span>

        <h2>
            Service Projects
        </h2>

    </div>


    <div class="card-grid">

        <% projects.slice(0, 3).forEach(
            project => {
        %>

            <article class="card">

                <h3>
                    <%= project.title %>
                </h3>

                <p>
                    <%= project.description %>
                </p>

                <p>
                    <strong>
                        Location:
                    </strong>

                    <%= project.location %>
                </p>

                <a
                    href="/projects/<%= project.project_id %>"
                    class="card-link"
                >
                    View Project →
                </a>

            </article>

        <% }); %>

    </div>


    <a
        href="/projects"
        class="button button-primary"
    >
        View All Projects
    </a>

</section>


<section class="content-section">

    <div class="page-header">

        <span class="section-label">
            EXPLORE
        </span>

        <h2>
            Categories
        </h2>

    </div>


    <div class="card-grid">

        <% categories.forEach(
            category => {
        %>

            <article class="card">

                <h3>
                    <%= category.category_name %>
                </h3>

                <p>
                    <%= category.description %>
                </p>

                <a
                    href="/categories"
                    class="card-link"
                >
                    View Category →
                </a>

            </article>

        <% }); %>

    </div>

</section>


<%- include("partials/footer") %>