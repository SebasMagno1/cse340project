<%- include("partials/header") %>

<h2><%= title %></h2>

<section>

    <h3>Welcome to Service Projects</h3>

    <p>
        Find volunteer opportunities and community
        service projects in your area.
    </p>

</section>


<section>

    <h3>Organizations</h3>

    <% if (organizations.length > 0) { %>

        <div class="grid">

            <% organizations.forEach(organization => { %>

                <article class="card">

                    <h4>
                        <%= organization.name %>
                    </h4>

                    <p>
                        <%= organization.description %>
                    </p>

                    <a href="/organizations">
                        View Organizations
                    </a>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <p>No organizations found.</p>

    <% } %>

</section>


<section>

    <h3>Service Projects</h3>

    <% if (projects.length > 0) { %>

        <div class="grid">

            <% projects.forEach(project => { %>

                <article class="card">

                    <h4>
                        <%= project.title %>
                    </h4>

                    <p>
                        <strong>Organization:</strong>
                        <%= project.organization_name %>
                    </p>

                    <p>
                        <%= project.description %>
                    </p>

                    <a href="/projects/<%= project.project_id %>">
                        View Project
                    </a>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <p>No service projects found.</p>

    <% } %>

</section>

<%- include("partials/footer") %>