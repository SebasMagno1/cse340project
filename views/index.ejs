<%- include("partials/header") %>

<section class="hero">
    <p class="eyebrow">Serve • Connect • Make a Difference</p>
    <h2>Find a Service Opportunity</h2>
    <p>
        Discover organizations and service projects where you can
        volunteer, contribute your skills, and make a difference
        in your community.
    </p>
    <a class="button" href="/projects">View Service Projects</a>
</section>

<section class="content-section">
    <div class="section-heading">
        <p class="eyebrow">Explore</p>
        <h2>What We Offer</h2>
    </div>

    <div class="card-grid">
        <article class="card">
            <span class="card-icon" aria-hidden="true">🤝</span>
            <h3>Organizations</h3>
            <p>
                Learn about organizations that provide meaningful
                service opportunities in the community.
            </p>
            <a href="/organizations">View Organizations</a>
        </article>

        <article class="card">
            <span class="card-icon" aria-hidden="true">🌱</span>
            <h3>Service Projects</h3>
            <p>
                Find projects where you can volunteer your time
                and help people around you.
            </p>
            <a href="/projects">View Projects</a>
        </article>

        <article class="card">
            <span class="card-icon" aria-hidden="true">📚</span>
            <h3>Categories</h3>
            <p>
                Explore service projects organized by different
                areas of community need.
            </p>
            <a href="/categories">View Categories</a>
        </article>
    </div>
</section>

<%- include("partials/footer") %>
