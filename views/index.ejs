<%- include("partials/header") %>

<section class="hero">

    <div class="hero-content">

        <span class="hero-label">
            COMMUNITY • SERVICE • IMPACT
        </span>

        <h2><%= title %></h2>

        <p>
            Discover organizations and service projects
            where you can volunteer, connect with others,
            and create a positive impact.
        </p>

        <div class="hero-actions">

            <a class="button button-primary" href="/projects">
                Explore Projects
            </a>

            <a class="button button-secondary" href="/organizations">
                View Organizations
            </a>

        </div>

    </div>

</section>


<section class="content-section">

    <div class="section-heading">

        <span class="section-label">
            GET INVOLVED
        </span>

        <h2>
            Find Your Opportunity to Serve
        </h2>

        <p>
            Explore organizations, projects, and categories
            to find a service opportunity that matches
            your interests.
        </p>

    </div>


    <div class="card-grid">

        <article class="card feature-card">

            <div class="card-icon">
                🤝
            </div>

            <h3>
                Organizations
            </h3>

            <p>
                Learn about organizations that provide
                meaningful service opportunities in
                the community.
            </p>

            <a class="card-link" href="/organizations">
                Explore Organizations →
            </a>

        </article>


        <article class="card feature-card">

            <div class="card-icon">
                🌱
            </div>

            <h3>
                Service Projects
            </h3>

            <p>
                Find projects where you can volunteer,
                contribute your skills, and help others.
            </p>

            <a class="card-link" href="/projects">
                Explore Projects →
            </a>

        </article>


        <article class="card feature-card">

            <div class="card-icon">
                📂
            </div>

            <h3>
                Categories
            </h3>

            <p>
                Browse service opportunities by category
                to quickly find projects that interest you.
            </p>

            <a class="card-link" href="/categories">
                Browse Categories →
            </a>

        </article>

    </div>

</section>


<section class="impact-section">

    <div class="impact-content">

        <span class="section-label">
            WHY SERVICE MATTERS
        </span>

        <h2>
            Small Actions Can Create
            a Big Impact
        </h2>

        <p>
            Volunteering gives you the opportunity to
            strengthen your community, develop new skills,
            meet people, and make a meaningful difference.
        </p>

    </div>

</section>


<%- include("partials/footer") %>