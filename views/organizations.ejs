<%- include("partials/header") %>

<section class="page-header">

    <span class="section-label">
        GET INVOLVED
    </span>

    <h2>
        Organizations
    </h2>

    <p>
        Explore organizations that provide meaningful
        service opportunities and support communities.
    </p>

</section>


<section class="card-grid organization-grid">


    <article class="card organization-card">

        <img
            src="/images/organization1.webp"
            alt="Community service organization"
        >

        <div class="card-content">

            <span class="card-category">
                Community
            </span>

            <h3>
                Community Organization
            </h3>

            <p>
                An organization dedicated to helping
                individuals and families in the local
                community.
            </p>

            <a class="card-link" href="/projects">
                View Projects →
            </a>

        </div>

    </article>


    <article class="card organization-card">

        <img
            src="/images/organization2.webp"
            alt="Environmental organization"
        >

        <div class="card-content">

            <span class="card-category">
                Environment
            </span>

            <h3>
                Environmental Organization
            </h3>

            <p>
                An organization focused on protecting
                nature and improving the environment
                through community service.
            </p>

            <a class="card-link" href="/projects">
                View Projects →
            </a>

        </div>

    </article>


    <article class="card organization-card">

        <img
            src="/images/organization3.webp"
            alt="Educational organization"
        >

        <div class="card-content">

            <span class="card-category">
                Education
            </span>

            <h3>
                Educational Organization
            </h3>

            <p>
                An organization that provides educational
                opportunities, tutoring, and support
                for students.
            </p>

            <a class="card-link" href="/projects">
                View Projects →
            </a>

        </div>

    </article>


</section>


<section class="callout">

    <h2>
        Ready to Get Involved?
    </h2>

    <p>
        Explore our service projects and find an
        opportunity to make a difference.
    </p>

    <a class="button button-primary" href="/projects">
        View Service Projects
    </a>

</section>


<%- include("partials/footer") %>