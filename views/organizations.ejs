<%- include("partials/header") %>


<section class="page-header">

    <span class="section-label">
        GET INVOLVED
    </span>

    <h2>
        <%= title %>
    </h2>

    <p>
        Explore organizations that provide meaningful
        service opportunities and support communities.
    </p>

</section>


<section class="card-grid organization-grid">

    <% organizations.forEach(
        organization => {
    %>

        <article class="card organization-card">

            <div class="card-content">

                <span class="card-category">
                    Community Organization
                </span>

                <h3>
                    <%= organization.organization_name %>
                </h3>

                <p>
                    <%= organization.description %>
                </p>


                <% if (organization.website) { %>

                    <p>

                        <strong>
                            Website:
                        </strong>

                        <a
                            href="<%= organization.website %>"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Visit Website
                        </a>

                    </p>

                <% } %>


                <a
                    class="card-link"
                    href="/projects"
                >
                    View Projects →
                </a>

            </div>

        </article>

    <% }); %>

</section>


<section class="callout">

    <h2>
        Ready to Get Involved?
    </h2>

    <p>
        Explore our service projects and find an
        opportunity to make a difference.
    </p>

    <a
        class="button button-primary"
        href="/projects"
    >
        View Service Projects
    </a>

</section>


<%- include("partials/footer") %>