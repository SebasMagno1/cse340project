<%- include("partials/header") %>


<section class="page-header">

    <span class="section-label">
        SERVICE PROJECT
    </span>

    <h2>
        <%= title %>
    </h2>

</section>


<section class="detail-card">

    <article class="card">

        <h3>
            <%= project.title %>
        </h3>


        <p>
            <%= project.description %>
        </p>


        <div class="project-details">

            <p>

                <strong>
                    Organization:
                </strong>

                <%= project.organization_name %>

            </p>


            <p>

                <strong>
                    Location:
                </strong>

                <%= project.location %>

            </p>


            <p>

                <strong>
                    Date:
                </strong>

                <%= new Date(
                    project.project_date
                ).toLocaleDateString(
                    "en-US"
                ) %>

            </p>


            <p>

                <strong>
                    Categories:
                </strong>

                <% if (
                    project.categories &&
                    project.categories.length > 0
                ) { %>

                    <%= project.categories.join(", ") %>

                <% } else { %>

                    Uncategorized

                <% } %>

            </p>

        </div>


        <a
            href="/projects"
            class="button button-primary"
        >
            Back to Projects
        </a>

    </article>

</section>


<%- include("partials/footer") %>