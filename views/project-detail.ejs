<%- include("partials/header") %>

<h2><%= title %></h2>

<article class="card">

    <h3>
        <%= project.title %>
    </h3>

    <p>
        <strong>Project ID:</strong>
        <%= project.project_id %>
    </p>

    <p>
        <strong>Organization:</strong>
        <%= project.organization_name %>
    </p>

    <p>
        <strong>Description:</strong>
        <%= project.description %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= project.date %>
    </p>

    <p>
        <strong>Categories:</strong>
        <%= project.categories %>
    </p>

    <a href="/projects">
        ← Back to Projects
    </a>

</article>

<%- include("partials/footer") %>