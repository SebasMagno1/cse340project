<%- include("partials/header") %>


<section class="page-header">

    <span class="section-label">
        VOLUNTEER OPPORTUNITIES
    </span>

    <h2>
        <%= title %>
    </h2>

    <p>
        Find opportunities to serve, connect with
        others, and make a positive impact.
    </p>

</section>


<section class="card-grid project-grid">

    <% projects.forEach(
        project => {
    %>

        <article class="card project-card">

            <div class="project-icon">
                🤝
            </div>


            <span class="card-category">
                <%= project.categories %>
            </span>


            <h3>
                <%= project.title %>
            </h3>


            <p>
                <%= project.description %>
            </p>


            <div class="project-details">

                <p>

                    <strong>
                        Organization:
                    </strong>

                    <%= project.organization_name %>

                </p>


                <p>

                    <strong>
                        Location:
                    </strong>

                    <%= project.location %>

                </p>


                <p>

                    <strong>
                        Date:
                    </strong>

                    <%= new Date(
                        project.project_date
                    ).toLocaleDateString(
                        "en-US"
                    ) %>

                </p>


                <p>

                    <strong>
                        Category:
                    </strong>

                    <%= project.categories %>

                </p>

            </div>


            <a
                class="card-link"
                href="/projects/<%= project.project_id %>"
            >
                View Project →
            </a>

        </article>

    <% }); %>

</section>


<% if (projects.length === 0) { %>

    <section class="callout">

        <h2>
            No Projects Available
        </h2>

        <p>
            There are currently no service projects
            available.
        </p>

    </section>

<% } %>


<%- include("partials/footer") %>